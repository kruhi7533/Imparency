// ─── Verification caseworker agent ──────────────────────────────────────────
// See docs/AGENT-VERIFICATION-CASEWORKER.md for the full design.
//
// Why these exist: lib/extraction-runner.ts is a fixed 3-step pipeline whose
// step count is known before it starts — correctly a single model call. The
// caseworker is an agent because step N+1 depends on what step N found (a name
// discrepancy between two certificates makes it read a third document and draft
// a question naming both values), so the run has to be a durable, resumable,
// auditable object rather than one request.
//
// The invariant these models do NOT change: only a human PATCH to
// app/api/admin/ngo-fields/[fieldId] can make a field VALIDATED, and only a
// VALIDATED field earns an NGOCompliance flag (lib/compliance-evidence.ts).
// The agent proposes evidence; it decides nothing.

enum AgentCaseStatus {
  NEW
  GATHERING
  ANALYZING
  AWAITING_NGO // question sent, waiting on the organisation
  AWAITING_ADMIN // a gated action is queued for a human
  RESOLVED
  ESCALATED
  ABANDONED // reminders exhausted or case aged out
  FAILED
}

enum AgentStepKind {
  MODEL_CALL // one generateContent round trip
  TOOL_CALL // a function the model asked for
  TOOL_RESULT // what it got back (truncated for storage)
  GATE // a write was queued for human approval
  TRANSITION // status change
  ERROR
}

/// One NGO's verification case. `state` holds the model conversation so a worker
/// can resume mid-case without replaying tool calls. Unique per (ngoId, caseType)
/// so a nudge can never fork a second case against the same NGO.
model AgentCase {
  id       String          @id @default(uuid())
  ngoId    String
  ngo      NGOProfile      @relation(fields: [ngoId], references: [id], onDelete: Cascade)
  caseType String          @default("NGO_VERIFICATION")
  status   AgentCaseStatus @default(NEW)

  // Budgets. Every one of these is a hard stop that ends in ESCALATED, never a
  // silent halt — a stopped case must always be visible to a human.
  stepsUsed     Int @default(0)
  stepBudget    Int @default(12)
  tokensIn      Int @default(0)
  tokensOut     Int @default(0)
  costPaise     Int @default(0) // integer paise; money is never a float
  remindersSent Int @default(0)

  /// Model conversation + scratchpad. Documents never enter here (they are read
  /// in an isolated model call), so this stays text-sized.
  state Json @default("{}")

  /// Optimistic worker claim, extended by a heartbeat while a case runs. A
  /// killed worker stops heartbeating and the case is reclaimed when this lapses.
  lockedUntil DateTime?
  lockedBy    String? // worker instance id, so a stuck lock is diagnosable

  waitingSince DateTime? // set when AWAITING_*; drives the SLA sweep
  nextWakeAt   DateTime? // earliest time a worker should pick this up again

  summary          String? // agent's closing summary, admin-facing
  escalationReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  steps          AgentStep[]
  pendingActions AgentPendingAction[]

  @@unique([ngoId, caseType])
  @@index([status, nextWakeAt])
  @@index([lockedUntil])
}

/// Append-only replay log — one row per loop event. This is the observability
/// substrate: usageMetadata is captured nowhere else in this repo, so "what does
/// one verification cost" is currently unanswerable.
model AgentStep {
  id     String        @id @default(uuid())
  caseId String
  case   AgentCase     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  seq    Int
  kind   AgentStepKind

  toolName     String?
  args         Json?
  result       Json? // truncated for storage; see TOOL_RESULT_MAX_CHARS
  ok           Boolean @default(true)
  errorMessage String?

  modelName String?
  tokensIn  Int     @default(0)
  tokensOut Int     @default(0)
  latencyMs Int     @default(0)

  createdAt DateTime @default(now())

  @@unique([caseId, seq])
  @@index([caseId, seq])
}

/// The human gate. Any tool marked `gated` lands here instead of executing.
/// EDITED keeps both the agent's draft (args) and the admin's rewrite
/// (finalArgs) — that delta is the quality metric, mirroring the `overrodeAi`
/// flag written by app/api/admin/ngo-fields/[fieldId]/route.ts.
model AgentPendingAction {
  id      String    @id @default(uuid())
  caseId  String
  case    AgentCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  stepSeq Int

  toolName  String
  args      Json // the agent's draft
  finalArgs Json? // what the admin actually approved, when edited

  status       String    @default("PENDING_APPROVAL") // PENDING_APPROVAL | APPROVED | EDITED | REJECTED | EXECUTED | EXPIRED
  decidedById  String?
  decidedAt    DateTime?
  rejectReason String?
  executedAt   DateTime?
  resultRef    String? // e.g. the created ReviewThread.id

  createdAt DateTime @default(now())

  @@index([status])
  @@index([caseId])
}

// ─── Fraud investigator (read-only, tool-calling) ───────────────────────────
// The one agent in this codebase that clears the agentic bar: given a single
// FraudAlert, it follows it — which query to run next depends on what the last
// one returned, and the hypothesis space (how an NGO might be gaming the
// platform) is open-ended, unlike NGO verification's fixed 5-field checklist.
//
// It runs to completion in ONE synchronous call — unlike the (deleted)
// verification caseworker, it never waits on a human reply or an NGO upload
// mid-run, so it needs no worker process, no lock/heartbeat, no pause/resume
// state machine. See lib/fraud-investigator/.

enum InvestigationStatus {
  RUNNING
  COMPLETED
  FAILED
}

model FraudInvestigation {
  id     String              @id @default(uuid())
  ngoId  String
  ngo    NGOProfile          @relation(fields: [ngoId], references: [id], onDelete: Cascade)
  status InvestigationStatus @default(RUNNING)

  /// What triggered this run: a FraudAlert id, a RiskReview id, or "manual:<adminId>".
  triggeredBy String

  /// The FraudAlert this run was investigating, if any — separate from
  /// triggeredBy, which only encodes this for the automatic ("alert:<id>")
  /// path. A manual run (triggeredBy = "manual:<adminId>") still passes an
  /// alertId when started from a specific alert, but that used to go nowhere:
  /// a manual investigation that found nothing had no persisted link back to
  /// the alert it was run against, so the admin console couldn't tell "this
  /// was checked and it's clean" from "nobody has looked at this yet" for
  /// that case. Nullable — plenty of runs (manual, no alert context) have none.
  alertId String?

  stepsUsed Int @default(0)
  tokensIn  Int @default(0)
  tokensOut Int @default(0)
  costPaise Int @default(0)

  /// Full tool-call trace: [{ seq, kind, toolName, args, result, ok }]. One-shot
  /// runs never need to resume, so this is a JSON array rather than a table —
  /// the caseworker's AgentStep table earned its keep by supporting crash
  /// recovery across days; nothing here runs longer than one request.
  trace Json @default("[]")

  riskLevel    String? // LOW | MEDIUM | HIGH | CRITICAL — null if it found nothing
  summary      String?
  riskReviewId String? // set if this run opened or added to a RiskReview

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ngoId])
  @@index([status])
  @@index([alertId])
}
