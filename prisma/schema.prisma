generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  DONOR
  NGO
  ADMIN
}

enum DonorPersona {
  INDIVIDUAL
  CSR_OFFICER
  HNI
  FOUNDATION
  GOVERNMENT
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum ProjectStatus {
  DRAFT
  PENDING_APPROVAL
  ACTIVE
  COMPLETED
  PAUSED
}

enum MilestoneStatus {
  PENDING
  IN_PROGRESS
  PROOF_SUBMITTED
  VERIFIED
  COMPLETED
}

enum DonationStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum DonorCategory {
  INDIAN_IN_INDIA // domestic donor — no FCRA constraint
  INDIAN_ABROAD // NRI/OCI — treated as foreign source unless NRI-eligible account used
  FOREIGN_NATIONAL // always foreign source — hard FCRA gate
}

enum FCRAStatus {
  NONE // never submitted
  PENDING // submitted, awaiting admin review
  ACTIVE // approved, expiry > 90 days away
  EXPIRING_SOON // approved, expiry within 90 days
  EXPIRED // approved but past expiry
  REJECTED // admin rejected
  REUPLOAD_REQUESTED // admin asked the NGO to re-upload
}

enum TeamRole {
  OWNER
  ADMIN
  FINANCE
  FIELD_STAFF
}

model User {
  id                      String                @id @default(uuid())
  email                   String                @unique
  passwordHash            String
  role                    Role                  @default(DONOR)
  name                    String                @default("Anonymous")
  avatar                  String?
  googleId                String?               @unique
  panNumber               String?
  phone                   String?
  city                    String?
  billingAddress          String?
  totalDonated            Decimal               @default(0.00) @db.Decimal(10, 2)
  fcmToken                String?
  companyName             String?
  isCorporate             Boolean               @default(false)
  gstNumber               String?
  donorCategory           DonorCategory?
  donorCategoryDeclaredAt DateTime?
  donorDeclarationVersion String? // tracks policy version for future consent re-prompts
  nriSourceDeclaration    String? // "ELIGIBLE_NRI_SOURCE" | "FOREIGN_SOURCE" | "NOT_SURE"
  donorPersona            DonorPersona?
  personaSetAt            DateTime?
  // Donor PAN verification (risk-based / just-in-time — gates 80G receipt issuance)
  panStatus               PanVerificationStatus @default(UNVERIFIED)
  panVerifiedAt           DateTime?
  panVerifiedVia          PanVerifiedVia?
  panRegisteredName       String? // name returned by the PAN provider (mismatch display / audit)
  panNameMatch            Boolean? // did registeredName match donor.name? null = no name returned

  // HNI specific fields
  hniAdvisorName  String?
  hniAdvisorEmail String?
  hniAnnualBudget Decimal? @db.Decimal(12, 2)

  // CSR specific fields
  csrRegistrationNumber String?
  csrBudget             Decimal? @db.Decimal(12, 2)

  // Foundation specific fields
  trustRegistrationId String?
  trust12a80gRegNo    String?
  trustAnnualBudget   Decimal? @db.Decimal(12, 2)

  donorTier         DonorTier         @default(STANDARD)
  reEngagementPath  ReEngagementPath?
  volunteerInterest Boolean           @default(false)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  ngoProfile          NGOProfile?
  donations           Donation[]
  notifications       Notification[]
  impactReports       ImpactReport[]
  followers           NGOFollower[]
  milestoneProofs     MilestoneProof[]
  adminReviews        MilestoneReview[]    @relation("AdminReviews")
  adminProjectReviews ProjectReview[]      @relation("AdminProjectReviews")
  consentLogs         ConsentLog[]
  reEngagementEvents  ReEngagementEvent[]
  teamMemberships     NGOTeamMember[]
  adminActionLogs     AdminActionLog[]     @relation("AdminActionLogs")
  passwordResetTokens PasswordResetToken[]
  donorInquiries      DonorInquiry[]

  // Emergency Crisis Relief
  crisisAlertsOptOut   Boolean                      @default(false)
  crisisEventsCreated  CrisisEvent[]                @relation("CrisisEventsCreated")
  initiativesSubmitted ReliefInitiative[]           @relation("InitiativesSubmitted")
  crisisDonations      CrisisDonation[]
  crisisDeliveries     CrisisNotificationDelivery[]
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

model NGOProfile {
  id                     String             @id @default(uuid())
  userId                 String             @unique
  user                   User               @relation(fields: [userId], references: [id])
  orgName                String
  registrationNumber     String             @unique
  panNumber              String             @unique
  address                String
  causeCategories        String[]
  verificationStatus     VerificationStatus @default(PENDING)
  healthScore            Decimal?           @db.Decimal(5, 2)
  healthScoreBreakdown   Json?
  ai_verification_report Json?
  isSuspended            Boolean            @default(false)
  suspensionReason       String?
  suspendedAt            DateTime?
  documents              String[]
  description            String
  website                String?
  foundedYear            Int
  adminNote              String?
  isDeleted              Boolean            @default(false)
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  logo_url               String?
  cover_image_url        String?
  joinCode               String?            @unique // Used for field worker self-registration via WhatsApp

  /// ─── Re-verification ──────────────────────────────────────────────────
  /// Set when evidence gathered AFTER approval contradicts that approval.
  ///
  /// `verificationStatus` deliberately stays VERIFIED. This organisation WAS
  /// approved by a named human on a date, and rewriting that to PENDING would
  /// erase the decision rather than question it. These fields say "the evidence
  /// behind that decision has since failed", which is a different statement.
  ///
  /// Nothing here suspends anyone. The platform does not take adverse action
  /// against an organisation on its own; it puts the decision back in front of
  /// a human with a deadline. See lib/verification-reversal.ts.
  reverificationRequiredAt  DateTime?
  reverificationReason      String?
  /// When a human is expected to have re-decided by. Past this, the case
  /// escalates in the console and the admin is emailed again — it still does
  /// not act on its own.
  reverificationDueAt       DateTime?
  /// Stops the overdue sweep emailing about the same case every single night.
  reverificationEscalatedAt DateTime?

  // Consent Tracking
  dataProcessingConsent     Boolean   @default(false)
  dataProcessingConsentDate DateTime?
  consentVersion            String?
  consentIpAddress          String?
  consentRevoked            Boolean   @default(false)
  consentRevokedAt          DateTime?

  projects           Project[]
  followers          NGOFollower[]
  screening          NgoScreening?
  compliance         NGOCompliance?
  riskReviews        RiskReview[]
  fieldWorkers       FieldWorker[]
  draftProofs        DraftProof[]
  teamMembers        NGOTeamMember[]
  teamInvites        TeamInvite[]
  donorInquiries     DonorInquiry[]
  crisisParticipants CrisisParticipant[]
  crisisUpdates      CrisisUpdate[]

  documentAnalyses    NgoDocumentAnalysis[]
  extractedFields     ExtractedField[]
  agentCases          AgentCase[]
  fraudInvestigations FraudInvestigation[]

  // Discover, the admin verification queue and every public listing filter on
  // verification state plus the two independent "shouldn't be visible" flags.
  // The unique keys already on this model cover PAN/registration/joinCode/user
  // lookups, but none of them help these.
  @@index([verificationStatus, isDeleted, isSuspended])
}

model NGOTeamMember {
  id        String     @id @default(uuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id])
  ngoId     String
  ngo       NGOProfile @relation(fields: [ngoId], references: [id])
  role      TeamRole   @default(FIELD_STAFF)
  createdAt DateTime   @default(now())

  @@unique([userId, ngoId])
}

model NGOCompliance {
  id    String     @id @default(uuid())
  ngoId String     @unique
  ngo   NGOProfile @relation(fields: [ngoId], references: [id])

  // Per-document verified flags + per-document timestamps
  panVerified            Boolean   @default(false)
  panVerifiedAt          DateTime?
  registrationVerified   Boolean   @default(false)
  registrationVerifiedAt DateTime?
  a12Verified            Boolean   @default(false)
  a12VerifiedAt          DateTime?
  a12DocumentUrl         String?
  eightyGVerified        Boolean   @default(false)
  eightyGVerifiedAt      DateTime?

  // FCRA-specific lifecycle
  fcraNumber          String?
  fcraStatus          FCRAStatus @default(NONE)
  fcraAuthority       String?    @default("Ministry of Home Affairs")
  fcraRegisteredSince Int? // year
  fcraIssueDate       DateTime?
  fcraExpiryDate      DateTime?
  fcraCertificateUrl  String?
  fcraExtractedData   Json? // raw Gemini extraction
  fcraAdminNote       String?
  fcraVerifiedAt      DateTime?

  // NOTE: compliance score & breakdown are derived on read — never stored here.

  verifiedById String? // admin user id (last action)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  auditLogs ComplianceAuditLog[]
}

model ComplianceAuditLog {
  id           String        @id @default(uuid())
  complianceId String
  compliance   NGOCompliance @relation(fields: [complianceId], references: [id])
  event        String // e.g. "FCRA_UPLOADED", "FCRA_APPROVED", "FCRA_EXPIRED", "PAN_VERIFIED", "80G_VERIFIED"
  detail       String? // human-readable line for the timeline
  actorId      String? // admin user id, or null for system/cron events
  createdAt    DateTime      @default(now())

  @@index([complianceId])
}

model Project {
  id            String        @id @default(uuid())
  ngoId         String
  ngo           NGOProfile    @relation(fields: [ngoId], references: [id])
  title         String
  description   String
  causeCategory String
  targetAmount  Decimal       @db.Decimal(10, 2)
  raisedAmount  Decimal       @default(0.00) @db.Decimal(10, 2)
  status        ProjectStatus @default(DRAFT)
  coverImage    String
  location      String

  // Geo Intelligence
  latitude        Float?
  longitude       Float?
  districtName    String?   @map("district_name")
  stateName       String?   @map("state_name")
  geoIntelligence Json?     @map("geo_intelligence")
  geoFetchedAt    DateTime? @map("geo_fetched_at")

  problem_statement String?
  expected_outcome  String?
  tocAnalysis       Json?    @map("toc_analysis")
  isDeleted         Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Admin approval gate
  reviewNote   String?
  reviewedAt   DateTime?
  reviewedById String?

  // AI pre-screening (advisory signal surfaced to admin in the review queue)
  aiScreeningScore  Int?
  aiScreeningResult String? // JSON: { score, recommendation, reasoning, flags }

  // Emergency Crisis Relief — nullable, zero impact on non-crisis projects
  crisisEventId       String?
  crisisEvent         CrisisEvent? @relation(fields: [crisisEventId], references: [id])
  isCrisisGeneralFund Boolean      @default(false)

  milestones              Milestone[]
  donations               Donation[]
  projectReviews          ProjectReview[]
  crisisDonationsAsTarget CrisisDonation[]

  @@index([ngoId])
  // Discover, admin review queues and the NGO profile all filter on these two
  // together — and `isDeleted` must be part of it, since a soft-deleted row is
  // excluded from essentially every read.
  @@index([status, isDeleted])
}

model ProjectReview {
  id         String   @id @default(uuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id])
  adminId    String
  admin      User     @relation("AdminProjectReviews", fields: [adminId], references: [id])
  action     String // "APPROVED" | "REJECTED"
  note       String?
  reviewedAt DateTime @default(now())

  @@index([projectId])
}

model Milestone {
  id            String          @id @default(uuid())
  projectId     String
  project       Project         @relation(fields: [projectId], references: [id])
  title         String
  description   String
  targetAmount  Decimal         @db.Decimal(10, 2)
  deadline      DateTime
  status        MilestoneStatus @default(PENDING)
  sequenceOrder Int
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  proofs        MilestoneProof[]
  impactReports ImpactReport[]
  reviews       MilestoneReview[]

  @@index([projectId])
  // The overdue sweep (risk-sweep cron, Today inbox, Impact Health) filters on
  // exactly this pair, and it is the one query here that scans the most rows.
  @@index([status, deadline])
}

model MilestoneProof {
  id                 String    @id @default(uuid())
  milestoneId        String
  milestone          Milestone @relation(fields: [milestoneId], references: [id])
  submittedById      String
  submittedBy        User      @relation(fields: [submittedById], references: [id])
  description        String
  mediaUrls          String[]
  documentUrls       String[]
  aiValidationResult String?
  aiValidationScore  Int?

  // Theory of Change Alignment
  theoryOfChangeAlignmentScore Int?
  theoryOfChangeReasoning      String?
  theoryOfChangeStrengths      String[]
  theoryOfChangeGaps           String[]

  submittedAt DateTime @default(now())

  @@index([milestoneId])
}

model MilestoneReview {
  id          String    @id @default(uuid())
  milestoneId String
  milestone   Milestone @relation(fields: [milestoneId], references: [id])
  proofId     String?
  adminId     String
  admin       User      @relation("AdminReviews", fields: [adminId], references: [id])
  action      String // "APPROVED" | "REJECTED"
  note        String?
  aiScore     Int?
  reviewedAt  DateTime  @default(now())

  @@index([milestoneId])
}

model Donation {
  id                  String         @id @default(uuid())
  donorId             String
  donor               User           @relation(fields: [donorId], references: [id])
  projectId           String
  project             Project        @relation(fields: [projectId], references: [id])
  amount              Decimal        @db.Decimal(10, 2)
  razorpayOrderId     String
  razorpayPaymentId   String?
  status              DonationStatus @default(PENDING)
  receiptUrl          String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  milestoneIds        String[]       @default([])
  retryCount          Int            @default(0)
  lastFailedAt        DateTime?
  retryToken          String?        @unique
  retryTokenExpiresAt DateTime?

  // INVARIANT: point-in-time compliance snapshot captured when the payment is
  // confirmed (webhook). IMMUTABLE — never modified afterwards, not even by
  // admins; corrections are recorded as new audit events, never as mutations.
  // Shape: { version, capturedAt, panStatus, panVerifiedVia, donorCategory,
  //          nriSourceDeclaration, ngoFcraStatus, ngoComplianceScore, ngoHealthScore }
  complianceSnapshot Json?

  impactReports ImpactReport[]
  taxReceipt    TaxReceipt?

  // Postgres does not index foreign keys automatically and Prisma only emits
  // indexes for @id and field-level @unique, so every one of these columns was
  // being sequential-scanned. Harmless at a few hundred rows, linear in table
  // size after that — see the matching indexes on Project/Milestone.
  @@index([projectId])
  // Donor-facing lists always filter by owner and usually by status together.
  @@index([donorId, status])
  // The admin dashboard's today/week/month/FY sums.
  @@index([status, createdAt])
  // The payment webhook looks a donation up by this on the confirmation path;
  // an unindexed scan here would sit directly in the money flow.
  @@index([razorpayOrderId])
}

model ImpactReport {
  id                   String    @id @default(uuid())
  donationId           String
  donation             Donation  @relation(fields: [donationId], references: [id])
  milestoneId          String
  milestone            Milestone @relation(fields: [milestoneId], references: [id])
  donorId              String
  donor                User      @relation(fields: [donorId], references: [id])
  aiGeneratedNarrative String
  sdgTags              String[]
  irisMetrics          String[]
  sentAt               DateTime  @default(now())
  readAt               DateTime?

  @@index([donationId])
  @@index([donorId])
}

model NGOFollower {
  donorId    String
  donor      User       @relation(fields: [donorId], references: [id])
  ngoId      String
  ngo        NGOProfile @relation(fields: [ngoId], references: [id])
  followedAt DateTime   @default(now())

  @@id([donorId, ngoId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  type      String
  title     String
  body      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  // This table had zero index scans in pg_stat_user_tables — every read of the
  // notification bell was a full scan. Ordering by createdAt is part of the
  // same query, so the composite serves both the filter and the sort, and its
  // leftmost prefix still covers plain userId lookups and unread counts.
  @@index([userId, createdAt])
}

model TaxReceipt {
  id            String   @id @default(uuid())
  donationId    String   @unique
  donation      Donation @relation(fields: [donationId], references: [id])
  receiptNumber String   @unique
  financialYear String
  pdfUrl        String
  issuedAt      DateTime @default(now())
}

model RateLimitLog {
  id           String   @id @default(uuid())
  identifier   String
  route        String
  requestCount Int      @default(1)
  windowStart  DateTime @default(now())

  // One row per (identifier, route). This is what lets `rateLimit()` do its
  // whole job in a single atomic INSERT .. ON CONFLICT DO UPDATE instead of a
  // findFirst followed by a create/update: it halves the round trips, and more
  // importantly it closes the race where two concurrent requests both read a
  // count below the limit and both increment, letting a caller exceed it.
  // The window is expressed as `windowStart` on the row and reset in the same
  // statement once it ages out, so a single row still models a rolling window.
  //
  // This also replaces the old [identifier, route, windowStart] index, which a
  // unique key on the first two columns makes redundant — there can only ever
  // be one matching row now, so the extra column bought nothing and cost a
  // second index to maintain on a write-heavy table.
  @@unique([identifier, route])
  // Supports the expired-window prune, which filters on windowStart alone.
  @@index([windowStart])
}

model NgoScreening {
  id                String     @id @default(uuid())
  ngoId             String     @unique
  ngo               NGOProfile @relation(fields: [ngoId], references: [id])
  summary           String
  extractedFields   Json
  documentChecklist Json
  consistencyOk     Boolean
  flags             Json
  recommendation    String // LOOKS_CLEAR | NEEDS_REVIEW | LOOKS_PROBLEMATIC
  confidence        Float
  status            String     @default("PENDING") // PENDING | READY | FAILED
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
}

// ─── Field-level document extraction (Requirements Analyst agent) ────────────
// NgoScreening produces ONE confidence for a whole document set and its
// extractedFields blob is never read back. These two models make extraction
// field-level so each NGOCompliance.*Verified flag can be earned by a
// specific, human-validated field instead of being set wholesale on approve.
//
// NGOProfile.documents is an untyped String[] — the agent classifies each
// upload by content rather than requiring the NGO to label it at registration.

enum NgoDocumentType {
  REGISTRATION_CERTIFICATE
  PAN_CARD
  TAX_EXEMPTION_12A
  TAX_EXEMPTION_80G
  FCRA_CERTIFICATE
  BANK_PROOF
  UNKNOWN
}

enum ExtractionStatus {
  EXTRACTED // confidence >= threshold and format checks passed; awaiting admin confirm
  NEEDS_REVIEW // low confidence, failed format check, or absent — mandatory human review
  VALIDATED // an admin confirmed (or corrected) the value
  REJECTED // an admin rejected the extracted value
}

model NgoDocumentAnalysis {
  id            String     @id @default(uuid())
  ngoId         String
  ngo           NGOProfile @relation(fields: [ngoId], references: [id], onDelete: Cascade)
  documentIndex Int // position in NGOProfile.documents[]
  documentUrl   String

  docType           NgoDocumentType @default(UNKNOWN)
  docTypeConfidence Float           @default(0)
  readable          Boolean         @default(false)
  note              String? // why unreadable / why classified this way

  /// The organisation name as printed on THIS document. Stored per-document so
  /// the documents can be compared against EACH OTHER — the per-field answer
  /// reports one winning name, which hides a certificate belonging to a
  /// differently-named entity. See findNameDisagreement in
  /// lib/verification-triage.ts.
  orgNameOnDocument String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  fields ExtractedField[]

  @@unique([ngoId, documentIndex])
  @@index([ngoId])
}

model ExtractedField {
  id         String               @id @default(uuid())
  ngoId      String
  ngo        NGOProfile           @relation(fields: [ngoId], references: [id], onDelete: Cascade)
  analysisId String?
  analysis   NgoDocumentAnalysis? @relation(fields: [analysisId], references: [id], onDelete: SetNull)

  fieldKey         String // "orgName" | "panNumber" | "registrationNumber" | "a12Number" | "eightyGNumber" | ...
  extractedValue   String? // null is a legitimate answer — the agent must not invent one
  submittedValue   String? // what the NGO typed on the registration form, for cross-check
  matchesSubmitted Boolean? // null when there is nothing to compare against

  confidence Float            @default(0)
  status     ExtractionStatus @default(NEEDS_REVIEW)
  flags      Json             @default("[]") // [{ severity, issue }]

  validatedValue String? // admin's corrected value, when they edited rather than accepted
  validatedById  String?
  validatedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([ngoId, fieldKey])
  @@index([ngoId])
  @@index([status])
}

enum AlertCategory {
  DOCUMENT_ERROR
  FRAUD_ALERT
}

enum AlertSubType {
  MISSING_DOCUMENT
  WRONG_DOCUMENT_TYPE
  EXPIRED_DOCUMENT
  UNREADABLE_DOCUMENT
  NAME_MISMATCH
  DUPLICATE_IDENTITY
  PAN_API_MISMATCH
  FAKE_REGISTRATION
  TAMPERED_DOCUMENT
}

model FraudAlert {
  id             String        @id @default(uuid())
  type           String
  entityId       String
  entityType     String
  description    String
  severity       String // "LOW", "MEDIUM", "HIGH"
  alertCategory  AlertCategory @default(FRAUD_ALERT)
  subType        AlertSubType?
  resolved       Boolean       @default(false)
  resolutionNote String?
  resolvedById   String? // admin user id — every resolution must be attributable
  resolvedAt     DateTime?
  createdAt      DateTime      @default(now())

  // The open-alert queues and dashboard badge counts.
  @@index([resolved, severity])
  // The risk sweep's dedupe lookup ("has this entity already been alerted for
  // this type?") — see checkGeneralPlatformAlerts in lib/risk-agent.ts.
  @@index([type, entityId, resolved])
  // entityId is also queried on its own, which the composite above cannot
  // serve because it is not the leftmost column.
  @@index([entityId])
}

model RiskReview {
  id         String     @id @default(uuid())
  ngoId      String
  ngo        NGOProfile @relation(fields: [ngoId], references: [id])
  alertIds   String[] // linked FraudAlert ids
  riskScore  Float?
  riskLevel  String // "LOW" | "MEDIUM" | "HIGH" | "CRITICAL"
  findings   Json?
  status     String     @default("OPEN") // "OPEN" | "REVIEWED" | "CLEARED" | "SUSPENDED"
  reviewedBy String?
  reviewNote String?
  createdAt  DateTime   @default(now())
  resolvedAt DateTime?

  // The fraud investigator checks for an existing OPEN review per NGO before
  // committing findings; the leftmost prefix also covers plain ngoId lookups.
  @@index([ngoId, status])
  // The Risk & Compliance queue filters by status alone.
  @@index([status])
}

/// ─── Risk engines ───────────────────────────────────────────────────────────
/// One standing risk score per entity, worst-first rankable.
///
/// NGO and DONOR scores live in the same table but are NEVER ranked against
/// each other: an NGO at 80 means "this organisation may not be what it claims"
/// and a donor at 80 means "this money may not be what it claims" — different
/// evidence, different queue, different action. Every read filters by
/// entityType, which is why the ranking index leads with it.
///
/// This is a MATERIALISED score, not a source of truth. It exists because a
/// worst-first page cannot sort or paginate over a value computed per row on
/// read (see the platform sweep that was 466ms of a 624ms page before it moved
/// to cron). The inputs remain derived on read where they already are —
/// `computeCompliance` in lib/ngo-compliance.ts is still never stored — and
/// `computedAt` is surfaced so a stale score is visibly stale rather than
/// quietly wrong.
model EntityRiskScore {
  id         String         @id @default(uuid())
  entityType RiskEntityType
  entityId   String

  /// 0..100, HIGHER IS WORSE — the opposite direction to healthScore and
  /// complianceScore, both of which are "higher is better". Named `score` with
  /// this comment rather than something like `riskPoints` because every band
  /// boundary below reads naturally in this direction; do not silently flip it.
  score Int
  band  RiskBand

  /// [{ code, label, points, detail }] — what actually drove the score, in the
  /// order applied. The Radar shows the top few verbatim: a number nobody can
  /// account for is a number nobody will act on.
  signals Json @default("[]")

  /// Inputs that could not be evaluated at all (e.g. an NGO with no extracted
  /// fields). Tracked separately from `score` because absence of evidence must
  /// never read as evidence of safety — a fully unknown entity is banded
  /// UNKNOWN, never LOW.
  unknownInputs Int @default(0)

  computedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([entityType, entityId])
  /// The Radar's only query shape: one entity type, worst first.
  @@index([entityType, score])
  @@index([entityType, band])
}

enum RiskEntityType {
  NGO
  DONOR
}

enum RiskBand {
  LOW
  MEDIUM
  HIGH
  /// Not "no risk found" — "not enough evidence to say". Sorts with HIGH in the
  /// console, never with LOW.
  UNKNOWN
}

/// One routing decision made from a risk score: what the Radar decided to do
/// about an entity, and what came of it.
///
/// A durable queue rather than a direct call, because the expensive end of this
/// pipeline has a hard throughput ceiling — measured 2026-08-26, roughly one
/// investigation per six minutes against a free-tier token cap. Firing an
/// investigation the moment a score crossed a line would mean a batch of newly
/// scored NGOs all launching at once and starving each other. A queue plus a
/// drain turns throughput into a number in a config file.
///
/// It is also the audit trail for the automated half of the pipeline: every
/// decision to spend the agent on an entity is a row here, with the score that
/// justified it captured at the time, so a later re-score cannot quietly
/// rewrite why something was investigated.
model RiskDispatch {
  id         String         @id @default(uuid())
  entityType RiskEntityType
  entityId   String

  action RiskAction
  status DispatchStatus @default(QUEUED)

  /// Score and band AS THEY WERE when this was queued. Deliberately copied
  /// rather than joined: EntityRiskScore is overwritten on every sweep, and a
  /// dispatch must stay explainable after the score that caused it has moved.
  scoreAtQueue Int
  bandAtQueue  RiskBand
  /// Human-readable justification, shown in the console next to the outcome.
  reason       String

  /// What the run produced — a FraudInvestigation id for INVESTIGATE, a field
  /// count for EXTRACT. Null until it finishes.
  resultRef String?
  error     String?

  queuedAt   DateTime  @default(now())
  startedAt  DateTime?
  finishedAt DateTime?

  /// The drain's query: oldest queued first, highest score first.
  @@index([status, scoreAtQueue])
  @@index([entityType, entityId, status])
}

enum RiskAction {
  /// Send it to the fraud investigator: there is evidence and it looks bad.
  INVESTIGATE
  /// Read its documents first. An entity banded UNKNOWN has nothing for the
  /// investigator to reason about — it would call get_document_evidence, get
  /// `analysed: false`, and correctly conclude nothing, at full token cost.
  /// Extraction is the cheap step that turns an unknown into a real score.
  EXTRACT
  /// Explicitly decided to spend nothing. Recorded rather than implied so the
  /// audit trail shows the choice was made.
  MONITOR
}

enum DispatchStatus {
  QUEUED
  RUNNING
  DONE
  FAILED
  /// Became irrelevant before it ran — usually the entity was re-scored and no
  /// longer warrants the action.
  SKIPPED
}

