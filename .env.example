# ─────────────────────────────────────────────────────────────────────────────
# Database connection settings (Neon/PostgreSQL)
#
# IMPORTANT — ONE DATABASE PER GIT BRANCH.
# Do NOT share a single Neon database across feature branches. Branches have
# different schemas, so a shared DB leaves you running against tables another
# branch hasn't created yet (the "RiskReview does not exist" class of crash).
#
# Each developer / each feature branch should use its OWN Neon branch:
#   1. Neon console -> your project -> Branches -> "Create branch" (off main).
#   2. Copy that branch's pooled connection string into DATABASE_URL below,
#      and its direct (non-pooled) string into DIRECT_URL.
#   3. `npm run dev` auto-runs `prisma migrate deploy` to bring your branch's
#      database up to the committed migrations. Then `npm run seed` for demo data.
#      This repo uses Prisma Migrate — do NOT run `prisma db push`; add schema
#      changes with `npm run db:migrate` so a migration is committed.
# Neon branches are copy-on-write (instant, free tier) — make one per branch.
# This file is committed; your real .env is gitignored. Never commit secrets.
# ─────────────────────────────────────────────────────────────────────────────
# Use connect_timeout=15 for serverless databases to prevent cold-start timeouts
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require&connect_timeout=15"
DIRECT_URL="postgresql://user:password@host:5432/dbname?sslmode=require&connect_timeout=15"

# NextAuth configuration
NEXTAUTH_SECRET="your-nextauth-secret-key"
NEXTAUTH_URL="http://localhost:3000"

# Storage Settings ("local", "cloudinary", "s3", or "r2")
# "local" loses all uploads on Vercel (ephemeral filesystem) — do not use in production.
# "cloudinary" is the recommended production default: reuses the CLOUDINARY_* credentials
# below, no separate cloud storage account/card required. See CLOUDINARY_* vars further down.
STORAGE_PROVIDER="cloudinary"

# Google Auth Credentials
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Gemini API Key (multimodal/vision document extraction)
GEMINI_API_KEY="your-gemini-api-key"

# Surepass PAN Verification API (https://surepass.io)
# Leave blank to run in mock mode (always valid). Set token to activate live PAN verification.
SUREPASS_API_TOKEN=

# Admin reminder emails
# ADMIN_EMAIL is the inbox where all admin digest/reminder emails are sent
ADMIN_EMAIL="your-admin-email@example.com"

# CRON_SECRET protects the /api/cron/reminders endpoint
# Set this to a long random string and pass it as the x-cron-secret header when calling from your cron job
CRON_SECRET="your-long-random-secret"

# Pitch deck
PITCH_DECK_NGO_NAME="Ananda Welfare Foundation"
PITCH_DECK_CONTACT_EMAIL="hello@impactbridge.in"
PITCH_DECK_CONTACT_PHONE="+91 98765 43210"
PITCH_DECK_WEBSITE="www.impactbridge.in"

# ─────────────────────────────────────────────────────────────────────────────
# Razorpay (donation payments) — required for any donation to work at all.
# Test-mode keys: https://dashboard.razorpay.com/app/keys
# ─────────────────────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your-razorpay-key-secret"
# Set in Razorpay Dashboard > Webhooks; verifies incoming payment webhooks
RAZORPAY_WEBHOOK_SECRET="your-razorpay-webhook-secret"
# Same as RAZORPAY_KEY_ID — exposed to the browser for the checkout widget
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_your_key_id"

# ─────────────────────────────────────────────────────────────────────────────
# Twilio (WhatsApp field-worker bot)
# ─────────────────────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID="your-twilio-account-sid"
TWILIO_AUTH_TOKEN="your-twilio-auth-token"
# (app/api/media-proxy also accepts TWILIO_API_KEY/TWILIO_API_SECRET as
#  fallback names for the two vars above — set only the pair above, not both)
TWILIO_WHATSAPP_NUMBER="whatsapp:+14155238886"
# Public URL Twilio should POST inbound WhatsApp messages to (e.g. your ngrok/deploy URL + /api/whatsapp)
TWILIO_WEBHOOK_URL="https://your-deployment.example.com/api/whatsapp"

# ─────────────────────────────────────────────────────────────────────────────
# Cloudinary — permanent re-hosting of WhatsApp proof photos
# (Twilio's own media URLs expire/require auth, so these get re-uploaded here)
# ─────────────────────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME="your-cloudinary-cloud-name"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"

# ─────────────────────────────────────────────────────────────────────────────
# Secondary Gemini key — used only by lib/whatsapp/worker.ts (legacy
# @google/generative-ai SDK). Everything else uses GEMINI_API_KEY above.
# ─────────────────────────────────────────────────────────────────────────────
GOOGLE_GENERATIVE_AI_API_KEY="your-gemini-api-key"

# ─────────────────────────────────────────────────────────────────────────────
# Email delivery — pick one. Gmail SMTP (nodemailer) is used if GMAIL_USER is
# set; otherwise falls back to Resend if RESEND_API_KEY is set.
# ─────────────────────────────────────────────────────────────────────────────
GMAIL_USER="your-gmail-address@gmail.com"
GMAIL_APP_PASSWORD="your-gmail-app-password"
RESEND_API_KEY=
RESEND_FROM_EMAIL="ImpactBridge <onboarding@resend.dev>"

# ─────────────────────────────────────────────────────────────────────────────
# Firebase Admin — push notifications (FCM). JSON service account, as a string.
# ─────────────────────────────────────────────────────────────────────────────
FIREBASE_SERVICE_ACCOUNT=

# ─────────────────────────────────────────────────────────────────────────────
# S3/R2 file storage — only needed if STORAGE_PROVIDER is "s3" or "r2" above.
# ─────────────────────────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET_NAME=
AWS_REGION="us-east-1"
# Optional: only for S3-compatible providers other than AWS (e.g. Cloudflare R2)
AWS_ENDPOINT=
# Optional: custom CDN domain fronting the bucket
AWS_CDN_URL=

# ─────────────────────────────────────────────────────────────────────────────
# Geo-intelligence enrichment for project locations (optional — feature
# degrades gracefully without these)
# ─────────────────────────────────────────────────────────────────────────────
DATA_GOV_IN_API_KEY=
AGROMONITORING_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Server-to-server auth secret for internal calls (e.g. the donation webhook
# triggering the donor re-engagement endpoint on itself)
# ─────────────────────────────────────────────────────────────────────────────
INTERNAL_API_SECRET="your-long-random-secret"

# ─────────────────────────────────────────────────────────────────────────────
# Error capture (lib/observability.ts)
#
# Swallowed failures are always written to stderr as one-line JSON prefixed
# with "[capture]" — searchable and alertable in Vercel logs with no setup.
#
# Optionally also POST every captured error to a collector: a Slack/Discord
# incoming webhook, or any HTTPS endpoint that accepts JSON. Delivery is
# fire-and-forget with a 3s timeout, so an unreachable collector can never
# slow down or break a request. Leave blank to log only.
# ─────────────────────────────────────────────────────────────────────────────
ERROR_WEBHOOK_URL=
